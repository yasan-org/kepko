{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "yasanglass"
  ],
  "reviewers": [
    "yasanglass"
  ],
  "assignAutomerge": true,
  "timezone": "Europe/Prague",
  "schedule": [
    "* 1-5 * * *"
  ],
  "gitIgnoredAuthors": [
    "346567311+yasan-glass-bot[bot]@users.noreply.github.com"
  ],
  "automerge": true,
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "description": "Security fixes skip the release-age wait, the night window and the shared group: their own pull request, merged once CI passes",
    "groupName": null,
    "minimumReleaseAge": null,
    "schedule": [],
    "automerge": true,
    "addLabels": [
      "security"
    ]
  },
  "minimumReleaseAge": "28 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customDatasources": {
    "android-platforms": {
      "description": "Reads the Android API levels from Google's Android SDK repository manifest",
      "defaultRegistryUrlTemplate": "https://dl.google.com/android/repository/repository2-3.xml",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$distinct(releases.$match(version, /path=\"platforms;android-(\\d+)(\\.\\d+)?\"/).groups[0]).{\"version\": $}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Android compile SDK in the version catalog",
      "managerFilePatterns": [
        "/(^|/)gradle/libs\\.versions\\.toml$/"
      ],
      "matchStrings": [
        "android-sdk-compile = \"(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "android-compile-sdk",
      "datasourceTemplate": "custom.android-platforms",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track the Android target SDK in the version catalog",
      "managerFilePatterns": [
        "/(^|/)gradle/libs\\.versions\\.toml$/"
      ],
      "matchStrings": [
        "android-sdk-target = \"(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "android-target-sdk",
      "datasourceTemplate": "custom.android-platforms",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Minor updates settle for two weeks; the 28-day default above covers major and everything else",
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Patches settle for a week",
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Below 1.0 a minor bump is a breaking one, so it waits as long as a major",
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "28 days"
    },
    {
      "description": "Alpha and beta bumps change APIs whatever their update type says, so they wait as long as a major",
      "matchCurrentVersion": "/(alpha|beta|rc|dev|eap)/i",
      "minimumReleaseAge": "28 days"
    },
    {
      "description": "kotlinx-datetime's -compat builds are a compatibility artifact for 0.6.x consumers, not newer releases",
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-datetime"
      ],
      "allowedVersions": "!/-compat$/"
    },
    {
      "description": "Every update lands in one pull request, merged once CI passes; last so it overrides the presets' groups",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "dependencies",
      "groupSlug": "all",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Android API level bumps get their own pull request and wait for a person: a new compile SDK can need a newer Android Gradle Plugin, and a new target SDK changes how the sample behaves on devices, which CI does not see; after the shared group so it wins",
      "matchDepNames": [
        "android-compile-sdk",
        "android-target-sdk"
      ],
      "groupName": "Android SDK",
      "groupSlug": "android-sdk",
      "automerge": false
    }
  ]
}
